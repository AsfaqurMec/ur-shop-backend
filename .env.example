# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# MySQL (mysql2)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=digital_products

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Uploads (multer). In production use absolute path outside web root (e.g. /home/user/private/uploads)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Email (nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com
# Display name in email header/subjects (optional)
MAIL_APP_NAME=Digital Store
STORE_NAME=
STORE_TAGLINE=
SUPPORT_EMAIL=
# Comma-separated inboxes for "new order" alerts (optional; ADMIN_EMAIL is an alias)
ADMIN_NOTIFICATION_EMAIL=admin@example.com
# If the server still rejects mail, try true (From = SMTP_USER only)
MAIL_FORCE_SMTP_FROM=false
# Set false only for dev/self-signed SMTP (insecure)
SMTP_TLS_REJECT_UNAUTHORIZED=true
# Welcome email after registration (default: true). Set false / 0 / no / off to disable
MAIL_SEND_WELCOME_EMAIL=true
# Customer-facing site URL for dashboard links in emails (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Subscription “expires tomorrow” emails: POST {API_PREFIX}/cron/subscription-expiry-reminders with header X-Cron-Secret
# Generate a long random string. Schedule daily: npm run cron:subscription-reminders (needs API running) or npm run build && npm run jobs:subscription-reminders
CRON_SECRET=
# If the trigger script runs on another machine, set API origin only (no /api suffix), e.g. https://api.example.com
# CRON_TRIGGER_BASE_URL=

# bKash Tokenized Checkout (optional). Callback URL defaults to FRONTEND_URL/checkout/bkash-callback
# BKASH_ENABLED=true
# BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_AGREEMENT_ID=
# BKASH_CALLBACK_BASE_URL=http://localhost:3000/checkout/bkash-callback
# BKASH_PENDING_EXPIRY_MINUTES=5
# Shown on checkout for manual mobile banking (send-to numbers / labels)
# BKASH_MANUAL_MERCHANT_NUMBER=01XXXXXXXXX
# BKASH_MANUAL_ACCOUNT_NAME=Your Store Name
# NAGAD_MANUAL_MERCHANT_NUMBER=01XXXXXXXXX
# NAGAD_MANUAL_ACCOUNT_NAME=Your Store Name
# ROCKET_MANUAL_MERCHANT_NUMBER=01XXXXXXXXX
# ROCKET_MANUAL_ACCOUNT_NAME=Your Store Name
