{
  "name": "digital-products-backend",
  "version": "1.0.0",
  "description": "Backend API for digital products ecommerce platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
    "typecheck": "tsc --noEmit",
    "db:setup": "node scripts/run-migrations.js",
    "db:seed": "node scripts/seed-demo.js",
    "jobs:subscription-reminders": "node dist/jobs/runSubscriptionReminders.js",
    "cron:subscription-reminders": "node scripts/trigger-subscription-reminders.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/pdfkit": "^0.17.6",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.6.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^7.0.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
